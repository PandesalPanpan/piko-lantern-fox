# Copy to .env (same folder), fill in, then: chmod 600 .env
# NEVER commit .env or paste these values anywhere public.

# Bot token from the Discord Developer Portal -> Bot -> Reset Token. Placeholder only:
DISCORD_TOKEN=your-bot-token-goes-here

# Application (client) ID. This is public, not a secret.
DISCORD_CLIENT_ID=1563826219588386897

# ID of the server (guild) to register the slash commands in (Developer Mode -> right-click server -> Copy Server ID).
DISCORD_GUILD_ID=your-server-id-goes-here

# Public character page URL shown by /about (optional, https only).
PAGE_URL=https://example.invalid/piko/
